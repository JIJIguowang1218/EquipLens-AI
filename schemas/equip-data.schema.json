{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiplens.local/schemas/equip-data.schema.json",
  "title": "EquipLens 数据层交换/导出格式 v0.1",
  "description": "单车素材管理：模块间交换文件与 SQLite 导出包共用此格式。规范见 docs/data-model-spec.md",
  "type": "object",
  "required": ["meta", "vocab", "vehicles", "assets", "sources", "facts", "descriptions", "confirm_log"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["format_version", "exported_at"],
      "additionalProperties": false,
      "properties": {
        "format_version": { "const": "0.1" },
        "exported_at": { "type": "string", "minLength": 1 }
      }
    },
    "vocab": { "type": "array", "items": { "$ref": "#/$defs/VocabTerm" } },
    "vehicles": { "type": "array", "items": { "$ref": "#/$defs/Vehicle" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/Asset" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/Source" } },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/Fact" } },
    "descriptions": { "type": "array", "items": { "$ref": "#/$defs/Description" } },
    "confirm_log": { "type": "array", "items": { "$ref": "#/$defs/ConfirmLogEntry" } }
  },
  "$defs": {
    "Uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "IsoTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },

    "ViewAngle": { "enum": ["hero_lf", "hero_rf", "front", "rear", "side_l", "side_r", "ortho_sheet", "detail", "interior", "scene", "nameplate"] },
    "AssetNature": { "enum": ["render", "official_photo", "real_photo", "report_screenshot"] },
    "QualityFlag": { "enum": ["blur", "overexposed", "occluded", "cluttered", "watermarked"] },
    "License": { "enum": ["client_provided", "self_captured", "web_official", "web_third_party"] },
    "BindingStatus": { "enum": ["unbound", "provisional", "confirmed"] },
    "BindingEvidence": { "enum": ["none", "self_derived", "region_match", "co_occurrence_labeled", "co_occurrence_only", "human"] },
    "ConfirmStatus": { "enum": ["machine_tagged", "confirmed", "rejected"] },
    "ConfirmMethod": { "enum": ["single", "batch", "auto"] },
    "AxisType": { "enum": ["structure", "design_feature", "intent"] },
    "Scope": { "enum": ["family", "model"] },
    "NodeType": { "enum": ["whole", "part"] },
    "ListStatus": { "enum": ["candidate", "locked"] },
    "AssetKind": { "enum": ["source_image", "crop"] },
    "BBox": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },

    "Vehicle": {
      "type": "object",
      "required": ["id", "brand", "model_name", "list_status", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "brand": { "type": "string", "minLength": 1 },
        "model_name": { "type": "string", "minLength": 1 },
        "category": { "type": ["string", "null"] },
        "generation": { "type": ["string", "null"] },
        "list_status": { "$ref": "#/$defs/ListStatus" },
        "hero_asset_id": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "project_id": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/IsoTime" }
      }
    },

    "Asset": {
      "type": "object",
      "required": ["id", "binding_status", "binding_evidence", "kind", "file_path", "view_angle", "asset_nature", "hash_sha256", "confirm_status", "created_at", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "vehicle_id": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "binding_status": { "$ref": "#/$defs/BindingStatus" },
        "binding_evidence": { "$ref": "#/$defs/BindingEvidence" },
        "kind": { "$ref": "#/$defs/AssetKind" },
        "parent_asset_id": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "crop_bbox": { "oneOf": [{ "$ref": "#/$defs/BBox" }, { "type": "null" }] },
        "file_path": { "type": "string", "minLength": 1 },
        "view_angle": { "$ref": "#/$defs/ViewAngle" },
        "asset_nature": { "$ref": "#/$defs/AssetNature" },
        "part_id": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "quality_flags": { "type": "array", "items": { "$ref": "#/$defs/QualityFlag" } },
        "hash_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "phash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
        "confirm_status": { "$ref": "#/$defs/ConfirmStatus" },
        "notes": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/IsoTime" },
        "updated_at": { "$ref": "#/$defs/IsoTime" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "crop" } }, "required": ["kind"] },
          "then": {
            "required": ["parent_asset_id", "crop_bbox"],
            "properties": {
              "parent_asset_id": { "$ref": "#/$defs/Uuid" },
              "crop_bbox": { "$ref": "#/$defs/BBox" }
            }
          },
          "else": {
            "properties": {
              "parent_asset_id": { "const": null },
              "crop_bbox": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "binding_status": { "const": "unbound" } }, "required": ["binding_status"] },
          "then": { "properties": { "vehicle_id": { "const": null }, "binding_evidence": { "const": "none" } } },
          "else": {
            "required": ["vehicle_id"],
            "properties": { "binding_evidence": { "not": { "const": "none" } } }
          }
        }
      ]
    },

    "Source": {
      "type": "object",
      "required": ["id", "asset_id", "license", "is_primary"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "asset_id": { "$ref": "#/$defs/Uuid" },
        "url": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] },
        "retrieved_at": { "oneOf": [{ "$ref": "#/$defs/IsoTime" }, { "type": "null" }] },
        "license": { "$ref": "#/$defs/License" },
        "is_primary": { "type": "integer", "enum": [0, 1] },
        "note": { "type": ["string", "null"] }
      }
    },

    "Fact": {
      "type": "object",
      "required": ["id", "vehicle_id", "field_key", "value", "confirm_status", "created_at", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "vehicle_id": { "$ref": "#/$defs/Uuid" },
        "field_key": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "unit": { "type": ["string", "null"] },
        "source_id": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "confirm_status": { "$ref": "#/$defs/ConfirmStatus" },
        "created_at": { "$ref": "#/$defs/IsoTime" },
        "updated_at": { "$ref": "#/$defs/IsoTime" }
      }
    },

    "Description": {
      "type": "object",
      "required": ["id", "vehicle_id", "node_type", "axis_type", "scope", "body", "evidence_asset_ids", "confirm_status", "version", "created_at", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "vehicle_id": { "$ref": "#/$defs/Uuid" },
        "node_type": { "$ref": "#/$defs/NodeType" },
        "part_id": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "axis_type": { "$ref": "#/$defs/AxisType" },
        "scope": { "$ref": "#/$defs/Scope" },
        "body": { "type": "string", "minLength": 1 },
        "evidence_asset_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Uuid" } },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/Uuid" } },
        "confirm_status": { "$ref": "#/$defs/ConfirmStatus" },
        "version": { "type": "integer", "minimum": 1 },
        "created_at": { "$ref": "#/$defs/IsoTime" },
        "updated_at": { "$ref": "#/$defs/IsoTime" }
      },
      "allOf": [
        {
          "if": { "properties": { "node_type": { "const": "part" } }, "required": ["node_type"] },
          "then": {
            "required": ["part_id"],
            "properties": { "part_id": { "type": "string", "minLength": 1 } }
          },
          "else": { "properties": { "part_id": { "const": null } } }
        }
      ]
    },

    "ConfirmLogEntry": {
      "type": "object",
      "required": ["id", "op_id", "object_type", "object_id", "field", "machine_value", "confirmed_value", "method", "confirmed_at", "confirmed_by"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "op_id": { "type": "string", "minLength": 1 },
        "object_type": { "enum": ["vehicle", "asset", "source", "fact", "description"] },
        "object_id": { "$ref": "#/$defs/Uuid" },
        "field": { "type": "string", "minLength": 1 },
        "machine_value": { "type": ["string", "number", "boolean", "null"] },
        "confirmed_value": { "type": ["string", "number", "boolean", "null"] },
        "method": { "$ref": "#/$defs/ConfirmMethod" },
        "confirmed_at": { "$ref": "#/$defs/IsoTime" },
        "confirmed_by": { "type": "string", "minLength": 1 }
      }
    },

    "VocabTerm": {
      "type": "object",
      "required": ["id", "type", "term", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["part"] },
        "term": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "retired"] },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
