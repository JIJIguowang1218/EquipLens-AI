{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "EquipLens text retrieval plan",
 "type": "object",
 "required": ["batch_id", "queries", "quota", "negative_terms", "relevant_terms", "budget"],
 "properties": {
  "batch_id": {"type": "string", "minLength": 1},
  "purpose": {"type": "string"},
  "category": {"type": "string"},
  "models": {"type": "array", "items": {"type": "string"}},
  "profile_ref": {"type": ["string", "null"]},
  "profile_status": {"type": "string", "enum": ["found", "missing", "draft"]},
  "queries": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "array",
    "items": {"type": "string", "minLength": 2},
    "minItems": 1
   }
  },
  "quota": {
   "type": "object",
   "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 60}
  },
  "negative_terms": {"type": "array", "items": {"type": "string"}},
  "relevant_terms": {"type": "array", "items": {"type": "string"}, "minItems": 1},
  "skip_domains": {"type": "array", "items": {"type": "string"}},
  "serp_channel": {"type": "string", "enum": ["auto", "baidu", "bing"]},
  "source_trust": {
   "type": "object",
   "additionalProperties": {"type": "string"}
  },
  "budget": {
   "type": "object",
   "required": ["max_queries", "max_fetch", "max_rounds"],
   "properties": {
    "max_queries": {"type": "integer", "minimum": 1, "maximum": 40},
    "max_fetch": {"type": "integer", "minimum": 1, "maximum": 60},
    "max_rounds": {"type": "integer", "minimum": 1, "maximum": 3},
    "per_type_quota": {"type": "integer", "minimum": 1, "maximum": 60}
   },
   "additionalProperties": false
  },
  "round": {"type": "integer", "minimum": 1, "maximum": 3},
  "fallback": {"type": "array", "items": {"type": "string"}}
 },
 "additionalProperties": false
}
