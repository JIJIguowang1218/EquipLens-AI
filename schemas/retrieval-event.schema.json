{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EquipLens retrieval event v0.1",
  "type": "object",
  "required": ["run_id", "from", "to", "action"],
  "properties": {
    "ts": {"type": "string"},
    "run_id": {"type": "string", "minLength": 1},
    "from": {"type": "string"},
    "to": {"type": "string"},
    "action": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "ref": {"type": "string"}
  }
}
