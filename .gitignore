# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 环境变量与密钥（严禁提交）
.env
.env.*
*.pem
credentials*.json

# Node / 前端
node_modules/
dist/
build/
.vite/

# IDE
.idea/
.vscode/
*.swp

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时产物
*.log
tmp/
output/

# 产品数据：素材图片与数据库严禁提交（版权/隐私/二进制）；轻量审计文本放行
# data/ 正式库（真实项目用，不提交素材/DB）；data-test/ 测试库=评测集（同规则）
data/*
!data/*.json
!data/reviews/
data/reviews/*
!data/reviews/*.json
data-test/*
!data-test/*.json
!data-test/reviews/
data-test/reviews/*
!data-test/reviews/*.json
# 调研语料（T16 起）：轻量审计文本，须随 git 同步供人审核
!data-test/corpus/
!data-test/corpus/**
# 运行轨迹（时间/token/工具/决策）：审计与面试复盘用，轻量 JSON
!data-test/runs/
!data-test/runs/**
# L3 评测集：人工/LLM 标注的段落级判定基准
!data-test/evals/
!data-test/evals/**
