# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 环境变量与密钥（严禁提交）
.env
.env.*
*.pem
credentials*.json

# Node / 前端
node_modules/
dist/
build/
.vite/

# IDE
.idea/
.vscode/
*.swp

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时产物
*.log
tmp/
output/

# 产品数据：素材图片与数据库严禁提交（版权/隐私/二进制）；轻量审计文本放行
# data/ 正式库（真实项目用，不提交素材/DB）；data-test/ 测试库=评测集（同规则）
data/*
!data/*.json
# legacy 静默词表：需要入库以便审计与旧脚本，但不被主代码默认加载
!data/legacy/
!data/legacy/**
!data/reviews/
data/reviews/*
!data/reviews/*.json
data-test/*
!data-test/*.json
!data-test/reviews/
data-test/reviews/*
!data-test/reviews/*.json
# 调研语料（T16 起）：轻量审计文本，须随 git 同步供人审核
!data-test/corpus/
!data-test/corpus/**
# 运行轨迹（时间/token/工具/决策）：审计与面试复盘用，轻量 JSON
!data-test/runs/
!data-test/runs/**
# L3 评测集：人工/LLM 标注的段落级判定基准
!data-test/evals/
!data-test/evals/**
# 任务单生成产物（API brief + meta；不含图片）
!data-test/briefs/
!data-test/briefs/**
# 审核包 HTML（T3–T12 审计证据，自包含缩略图；夹具素材/缓存/DB 仍忽略）
!data-test/review-*.html
assets/footage/raw/
assets/tts/
promo/.hyperframes/
promo/assets/data.json
promo-remotion/node_modules/
promo-remotion/.tmp/
vendor/
promo/assets/ui/
promo/assets/vo/
promo/assets/bed.wav
promo/assets/vo-track.wav
promo/assets/mix.wav
promo/assets/gate/
promo/assets/parts.json
promo/assets/rec/
promo/assets/parts5.json

# 测试夹具：P1 状态机测试必需，轻量 JSON/MD
!data-test/retrieval-fixtures-20261109/
!data-test/retrieval-fixtures-20261109/**

# 运行图片默认不入库（体积/版权；与 docs/SYNC-MANIFEST.md「不同步」一致）。
# 需要审计某轮图片时，单独 `git add -f data-test/runs/<run>/images/...`。
data-test/runs/**/images/
